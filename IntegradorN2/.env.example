# Copiar como .env y completar. El archivo .env NO se versiona.

# Base de datos (E0-01)
DB_URL=jdbc:postgresql://localhost:5432/dulcemayor
DB_USER=postgres
DB_PASSWORD=postgres

# Seguridad (E1-01)
JWT_SECRET=
JWT_EXPIRATION=

# Correo (E1-06)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# CORS y URLs de los clientes
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_URL_PUBLIC=
APP_URL_ADMIN=

# Clientes E0-02: configurar en client-admin/.env y client-public/.env.
# El .env de la raiz no se carga en Vite.
# VITE_API_URL=/api
# API_PROXY_TARGET=http://localhost:8080
# VITE_PUBLIC_URL=http://localhost:5174 (solo client-admin)
# VITE_ADMIN_URL=http://localhost:5173 (solo client-public)

# Servicios externos
DOLARAPI_URL=https://dolarapi.com/v1/dolares/oficial
OLLAMA_URL=
OLLAMA_MODEL=
