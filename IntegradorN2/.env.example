# Copiar como .env y completar. El archivo .env NO se versiona.

# Base de datos (E0-01)
# DB_URL la usa el servidor fuera de Docker; docker-compose.yml la arma apuntando al servicio "db".
DB_URL=jdbc:postgresql://localhost:5432/dulcemayor
DB_NAME=dulcemayor
DB_USER=postgres
# Obligatoria para docker compose (también es la clave con la que se crea la base)
DB_PASSWORD=postgres

# Docker (E0-09): puertos publicados en la máquina
DB_PORT=5432
BACKEND_PORT=8080
ADMIN_PORT=5173
PUBLIC_PORT=5174

# Seguridad (E1-01)
# Secreto para firmar los JWT (HS256): al menos 32 caracteres. Vacío = clave al azar en cada
# arranque (solo desarrollo: reiniciar el servidor cierra todas las sesiones).
# Para generar uno: openssl rand -base64 48
JWT_SECRET=
# Duración del token en segundos. Vacío = 3600 (una hora).
JWT_EXPIRATION=

# Acceso con Google para minoristas. Configurá un cliente de tipo Aplicación web.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Origen del sitio público. El callback autorizado es este origen + /api/auth/google/callback.
GOOGLE_OAUTH_PUBLIC_URL=http://localhost:5174

# Correo (E1-06)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# CORS y URLs de los clientes. CORS_ORIGINS separados por coma; vacío = localhost:5173 y 5174 (E1-01)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_URL_PUBLIC=
APP_URL_ADMIN=
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Clientes E0-02: configurar en client-admin/.env y client-public/.env.
# El .env de la raiz no se carga en Vite.
# VITE_API_URL=/api
# API_PROXY_TARGET=http://localhost:8080
# VITE_PUBLIC_URL=http://localhost:5174 (solo client-admin)
# VITE_ADMIN_URL=http://localhost:5173 (solo client-public)

# Servicios externos
DOLARAPI_URL=https://dolarapi.com/v1/dolares/oficial
# Chatbot (E3-04). OLLAMA_URL vacía: http://localhost:11434 fuera de Docker y http://ollama:11434 en Docker
# (perfil "ollama"). OLLAMA_MODEL vacío = qwen2.5:3b (descargarlo con: docker compose exec ollama ollama pull qwen2.5:3b).
# OLLAMA_TIMEOUT_MS vacío = 60000 (sin GPU el modelo tarda unos segundos).
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=

# Mercado Pago Checkout Pro vía Orders API (E4-05). Dejar en blanco hasta cargar las credenciales.
# El Access Token es privado: guardarlo solo en este .env, nunca en el frontend ni en Git.
MERCADOPAGO_API_URL=https://api.mercadopago.com
MERCADOPAGO_ACCESS_TOKEN=
# Firma secreta de Webhooks, distinta del Access Token.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcionales: URLs HTTPS del frontend para resultados approved/rejected/pending.
# E4-08: después de pagar, el minorista vuelve a su panel de compras. En producción usar la URL HTTPS
# pública del sitio (Mercado Pago puede rechazar localhost para el regreso automático).
MERCADOPAGO_SUCCESS_URL=http://localhost:5174/cuenta/compras
MERCADOPAGO_FAILURE_URL=
MERCADOPAGO_PENDING_URL=
