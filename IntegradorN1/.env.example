# Copiá este archivo como .env (en esta misma carpeta) y completá tus credenciales. El .env no se sube a Git.
# Las variables de entorno del sistema tienen prioridad sobre el .env.

# Access token de prueba del vendedor (Tus integraciones > app > Credenciales de prueba). Empieza con APP_USR-.
MP_ACCESS_TOKEN=

# Clave secreta de Webhooks (Tus integraciones > app > Webhooks > Configurar notificaciones).
MP_WEBHOOK_SECRET=

# URL pública HTTPS del túnel (ngrok http 8080). Sin esto, Mercado Pago no vuelve al sitio ni notifica al webhook.
# APP_URL_BASE=https://xxxx.ngrok-free.app

# Authtoken de ngrok (no lo usa la app; es para "ngrok config add-authtoken <token>").
NGROK_AUTHTOKEN=
